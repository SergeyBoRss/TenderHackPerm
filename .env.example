APP_NAME=TenderHackPerm API
APP_VERSION=0.1.0
APP_ENV=dev
APP_PORT=8000
API_V1_PREFIX=/api/v1

POSTGRES_DB=tenderhackperm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_MIN_POOL_SIZE=4
POSTGRES_MAX_POOL_SIZE=10
POSTGRES_SSL_MODE=disable

IMPORT_DATA_DIR=data/imports
IMPORT_CTE_FILENAME=cte.xlsx
IMPORT_CONTRACTS_FILENAME=contracts.xlsx

EMBEDDINGS_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDINGS_DIMENSIONS=384
EMBEDDINGS_BATCH_SIZE=16
EMBEDDINGS_MAX_LENGTH=512
EMBEDDINGS_DOCUMENT_PREFIX=passage:
EMBEDDINGS_QUERY_PREFIX=query:

GEOPY_USER_AGENT=tenderhackperm
GEOPY_TIMEOUT_SECONDS=10

ANALYTICS_CATEGORY_ONLY_MULTIPLIER=0.65
ANALYTICS_FALLBACK_MULTIPLIER=0.2
ANALYTICS_GEO_DECAY_KM=1500.0
ANALYTICS_MOSCOW_SPB_PENALTY=0.7
ANALYTICS_REMOTE_PENALTY=0.55
ANALYTICS_KALININGRAD_PENALTY=0.8
ANALYTICS_TIME_HALF_LIFE_DAYS=365.0
ANALYTICS_IQR_MULTIPLIER=1.5
ANALYTICS_MISSING_EMBEDDING_WEIGHT=0.35
ANALYTICS_VECTOR_LIMIT=250
